+++ b/src/IMessage/Sources/IMessage/BBCNativeEmojiPickerSelection.swift
@@ -0,0 +1,136 @@
+import AppKit
+import ApplicationServices
+import Darwin
+import Foundation
+
+/// CharacterPicker's embedded glyph can advertise AXPress without selecting
+/// anything. Select its single-result row explicitly, then confirm exactly once.
+public enum BBCNativeEmojiPickerSelection {
+    public enum Failure: String, Error {
+        case ownership, search, glyph, container, selectionWrite, selectionRead, confirmation
+    }
+
+    public static func confirm(select: () throws -> Void, selected: () throws -> Bool?,
+                               owned: () -> Bool, submit: () throws -> Void) throws {
+        guard owned() else { throw Failure.search }
+        try select()
+        let deadline = Date().addingTimeInterval(0.75)
+        repeat {
+            guard owned() else { throw Failure.search }
+            guard let state = try selected() else { throw Failure.selectionRead }
+            if state {
+                guard owned() else { throw Failure.search }
+                try submit()
+                return
+            }
+            Thread.sleep(forTimeInterval: 0.05)
+        } while Date() < deadline
+        throw Failure.selectionRead
+    }
+
+    public static func activate(picker: AXUIElement, searchField: AXUIElement, glyph: AXUIElement,
+                                ownerPID: pid_t, query: String, emoji: String) throws {
+        var info = proc_bsdinfo()
+        let size = MemoryLayout<proc_bsdinfo>.size
+        guard getuid() != 0, getuid() == geteuid(), ownerPID > 0,
+              proc_pidinfo(ownerPID, PROC_PIDTBSDINFO, 0, &info, Int32(size)) == Int32(size),
+              info.pbi_uid == getuid(),
+              NSRunningApplication(processIdentifier: ownerPID)?.bundleIdentifier == "com.apple.MobileSMS",
+              [picker, searchField, glyph].allSatisfy({ pid($0) == ownerPID }),
+              string(picker, kAXRoleAttribute) == kAXPopoverRole,
+              descends(searchField, from: picker, ownerPID: ownerPID),
+              descends(glyph, from: picker, ownerPID: ownerPID) else { throw Failure.ownership }
+        guard emoji.count == 1, matches(glyph, emoji: emoji) else { throw Failure.glyph }
+        guard actions(searchField)?.contains(kAXConfirmAction) == true else { throw Failure.confirmation }
+
+        // The direct selected child can represent an entire row. It is safe
+        // only when that row has one actionable result: the exact glyph.
+        var branch = glyph
+        var target: (container: AXUIElement, row: AXUIElement)?
+        for _ in 0..<16 {
+            guard let parent = parent(branch), pid(parent) == ownerPID, !CFEqual(parent, picker) else { break }
+            if string(parent, kAXRoleAttribute) == kAXListRole,
+               settable(parent, kAXSelectedChildrenAttribute),
+               children(parent).contains(where: { CFEqual($0, branch) }),
+               singleActionableGlyph(in: branch, glyph: glyph, ownerPID: ownerPID) {
+                target = (parent, branch)
+                break
+            }
+            branch = parent
+        }
+        guard let target else { throw Failure.container }
+        func owned() -> Bool {
+            string(searchField, kAXValueAttribute) == query && matches(glyph, emoji: emoji)
+                && pid(glyph) == ownerPID && pid(picker) == ownerPID
+                && descends(glyph, from: picker, ownerPID: ownerPID)
+        }
+        try confirm(select: {
+            guard AXUIElementSetAttributeValue(target.container, kAXSelectedChildrenAttribute as CFString,
+                                              [target.row] as CFArray) == .success else { throw Failure.selectionWrite }
+        }, selected: {
+            guard let selected = attribute(target.container, kAXSelectedChildrenAttribute) as? [AXUIElement] else { return nil }
+            return selected.count == 1 && CFEqual(selected[0], target.row)
+        }, owned: owned, submit: {
+            guard owned(), singleActionableGlyph(in: target.row, glyph: glyph, ownerPID: ownerPID),
+                  let selected = attribute(target.container, kAXSelectedChildrenAttribute) as? [AXUIElement],
+                  selected.count == 1, CFEqual(selected[0], target.row),
+                  actions(searchField)?.contains(kAXConfirmAction) == true else { throw Failure.confirmation }
+            guard AXUIElementPerformAction(searchField, kAXConfirmAction as CFString) == .success else { throw Failure.confirmation }
+        })
+    }
+
+    private static func attribute(_ node: AXUIElement, _ key: String) -> CFTypeRef? {
+        var value: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(node, key as CFString, &value) == .success else { return nil }
+        return value
+    }
+    private static func string(_ node: AXUIElement, _ key: String) -> String? { attribute(node, key) as? String }
+    private static func children(_ node: AXUIElement) -> [AXUIElement] { attribute(node, kAXChildrenAttribute) as? [AXUIElement] ?? [] }
+    private static func parent(_ node: AXUIElement) -> AXUIElement? {
+        guard let raw = attribute(node, kAXParentAttribute), CFGetTypeID(raw) == AXUIElementGetTypeID() else { return nil }
+        return unsafeDowncast(raw, to: AXUIElement.self)
+    }
+    private static func pid(_ node: AXUIElement) -> pid_t? {
+        var value: pid_t = 0
+        return AXUIElementGetPid(node, &value) == .success ? value : nil
+    }
+    private static func settable(_ node: AXUIElement, _ key: String) -> Bool {
+        var value = DarwinBoolean(false)
+        return AXUIElementIsAttributeSettable(node, key as CFString, &value) == .success && value.boolValue
+    }
+    private static func actions(_ node: AXUIElement) -> [String]? {
+        var value: CFArray?
+        guard AXUIElementCopyActionNames(node, &value) == .success else { return nil }
+        return value as? [String]
+    }
+    private static func matches(_ node: AXUIElement, emoji: String) -> Bool {
+        let value = attribute(node, kAXValueAttribute)
+        return (value as? String) == emoji || (value as? NSAttributedString)?.string == emoji
+            || [kAXIdentifierAttribute, kAXTitleAttribute, kAXDescriptionAttribute].contains { string(node, $0) == emoji }
+    }
+    private static func descends(_ node: AXUIElement, from ancestor: AXUIElement, ownerPID: pid_t) -> Bool {
+        var cursor: AXUIElement? = node
+        for _ in 0..<16 {
+            guard let current = cursor, pid(current) == ownerPID else { return false }
+            if CFEqual(current, ancestor) { return true }
+            cursor = parent(current)
+        }
+        return false
+    }
+    private static func singleActionableGlyph(in row: AXUIElement, glyph: AXUIElement, ownerPID: pid_t) -> Bool {
+        var queue = [row], index = 0, actionable = [AXUIElement]()
+        while index < queue.count, queue.count <= 128 {
+            let node = queue[index]; index += 1
+            guard pid(node) == ownerPID else { return false }
+            guard let names = actions(node) else { return false }
+            if !Set(names).isDisjoint(with: [kAXPressAction, kAXConfirmAction, kAXPickAction]) { actionable.append(node) }
+            var raw: CFTypeRef?
+            let status = AXUIElementCopyAttributeValue(node, kAXChildrenAttribute as CFString, &raw)
+            if status == .success {
+                guard let descendants = raw as? [AXUIElement], queue.count + descendants.count <= 128 else { return false }
+                queue += descendants
+            } else if status != .noValue && status != .attributeUnsupported { return false }
+        }
+        return index == queue.count && actionable.count == 1 && CFEqual(actionable[0], glyph)
+    }
+}
